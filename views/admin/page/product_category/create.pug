extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug


block main
    +alert-error(5000)
    if role.permissions.includes("products-category_create") 
        h1.mb-4 Thêm mới danh mục sản phẩm

        form(
            action=`${prefixAdmin}/product_category/create`
            method="POST"
            enctype="multipart/form-data"
        )
            .form-group
                label(for="title") Tiêu đề
                input.form-control(
                    type="text"
                    id="title"
                    name="title"
                    required
                )
            .form-group
                label(for="parent_id") Danh mục cha
            
                select(
                    name="parent_id"
                    id="parent_id"
                    class="form-control"
                )
                    option(value="") -- Chọn danh mục cha --
                    if(record)
                        +select-tree(record)

            .form-group
                label(for="desc") Mô tả
                textarea.form-control.textarea-mce(
                    id="desc"
                    name="description"
                    rows="5"
                )
            

            
            div(
                class="form-group"
                upload-image
            )
                label(for="thumbnail") Ảnh
                input.form-control(
                    type="file"
                    class="form-control-file"
                    id="thumbnail"
                    name="thumbnail"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src = ""
                    upload-image-preview
                    class = "image-preview"
                )

            .form-group
                label(for="position") Vị trí
                input.form-control(
                    type="number"
                    id="position"
                    name="position"
                    placeholder="Tự động tăng"
                    min="1"
                )

            .form-group.form-check.form-check-inline
                input.form-check-input(
                    type="radio"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked
                )
                label.form-check-label(for="statusActive") Hoạt động

            .form-group.form-check.form-check-inline
                input.form-check-input(
                    type="radio"
                    id="statusInactive"
                    name="status"
                    value="inactive"
                )
                label.form-check-label(for="statusInactive") Dừng hoạt động

            .form-group
                button.btn.btn-primary(type="submit") Tạo mới

    script(src="/admin/js/product.js")
