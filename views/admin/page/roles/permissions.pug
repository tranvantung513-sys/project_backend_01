extend ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-success(5000)
    h1(class="mb-4") Phân quyền

    if record
        div(data-record = record)
        div(class="text-right")
            button(
                type="submit"
                class="btn btn-primary mb-3"
                button-submit
            ) Cập nhật

        table(
            class="table table-hover table-sm"
            table-permissions
        )
            thead
                tr
                    th Tính năng
                    each item in record
                        th.text-center #{item.title}
            tbody
                //- Row ID
                tr(data-name="id" class="d-none")
                    td
                    each item in record 
                        td.text-center
                            input(type="text" value=item.id readonly)

                //- Header Danh mục sản phẩm
                tr
                    td(colspan=record.length + 1)
                        b Danh mục sản phẩm

                //- Xem
                tr(data-name="products-category_view")
                    td Xem
                    each item in record
                        td.text-center
                            input(type="checkbox")

                //- Thêm mới
                tr(data-name="products-category_create")
                    td Thêm mới
                    each item in record
                        td.text-center
                            input(type="checkbox")

                //- Chỉnh sửa
                tr(data-name="products-category_edit")
                    td Chỉnh sửa
                    each item in record
                        td.text-center
                            input(type="checkbox")

                //- Xóa
                tr(data-name="products-category_delete")
                    td Xóa
                    each item in record
                        td.text-center
                            input(type="checkbox")


                tr
                    td(colspan=record.length + 1)
                        b Sản phẩm

                tr(data-name="products_view")
                    td Xem
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_create")
                    td Thêm mới
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_edit")
                    td Chỉnh sửa
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="products_delete")
                    td Xóa
                    each item in record
                        td.text-center
                            input(type="checkbox")


                tr
                    td(colspan=record.length + 1)
                        b Nhóm quyền

                tr(data-name="roles_view")
                    td Xem
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_create")
                    td Thêm mới
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_edit")
                    td Chỉnh sửa
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_delete")
                    td Xóa
                    each item in record
                        td.text-center
                            input(type="checkbox")
                tr(data-name="roles_permissions")
                    td Phân quyền
                    each item in record
                        td.text-center
                            input(type="checkbox")




    form(
        id="form-change-permissions"
        method="POST"
        action=`${prefixAdmin}/roles/permissions?_method=PATCH`
        class ="d-none"
    )
        div(class="form-group")
            input(
                type="text"
                class="form-control"
                name="permissions"  
            )    
    script(src="/admin/js/roles.js") 