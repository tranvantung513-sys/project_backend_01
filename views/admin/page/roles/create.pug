extends ../../layouts/default.pug


block main
    if role.permissions.includes("roles_create") 
        h1.mb-4 Thêm mới nhóm quyền

        form(
            action=`${prefixAdmin}/roles/create`
            method="POST"
        )
            .form-group
                label(for="title") Tiêu đề
                input.form-control(
                    type="text"
                    id="title"
                    name="title"
                    required
                )
        

            .form-group
                label(for="desc") Mô tả
                input(
                    type="text"
                    class="form-control"
                    id="desc"
                    name="description"
                )

            .form-group
                button.btn.btn-primary(type="submit") Tạo mới

        //- script(src="/admin/js/product.js")
